# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — required for the Stripe webhook and checkout
# confirmation flows. Without it, those code paths fail.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OAuth (Google / Facebook) needs no app env vars: enable each provider in the
# Supabase dashboard (Authentication > Providers) with its client ID/secret,
# and add <site-url>/auth/callback to the provider's authorized redirect URIs
# in addition to the Supabase callback URL shown in the dashboard.

# --- Stripe ---
# Without these, checkout/webhook/confirm routes return 500 (degrade gracefully).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL used to build Stripe success/cancel URLs.
FRONTEND_URL=http://localhost:3000

# --- Email (SMTP / Nodemailer) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Optional: dev tunnel for Stripe webhook testing (ngrok, etc.) ---
# Host only or full URL; used for allowedDevOrigins and image remotePatterns.
NGROK_HOST=

# --- Optional: admin login convenience alias ---
# Lets an admin type the alias instead of the full email on /admin/login.
NEXT_PUBLIC_ADMIN_LOGIN_ALIAS=
NEXT_PUBLIC_ADMIN_LOGIN_EMAIL=

# --- Sentry (error monitoring) ---
# No-op until the DSN is set, so local/dev never reports.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Only needed to upload source maps during `next build` (optional):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Supabase type generation (npm run db:types) ---
# Project ref for the linked Supabase project (Settings > General).
SUPABASE_PROJECT_ID=
